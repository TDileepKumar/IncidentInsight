# IncidentInsight environment template.
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored
# and must never be committed; only this template is tracked.
#
#   cp .env.example .env
#
# Both settings are OPTIONAL. Without an API key the whole application still
# works: parsing, clustering, ranking, the deterministic explanations, the
# dashboard and the chatbot's offline fallback all run locally with no network
# access. A key is only needed for the optional AI-enhanced explanations.

# Your OpenAI API key. Leave blank to run fully offline.
# Never commit a real key, and never paste it into the web UI.
OPENAI_API_KEY=

# Optional model override for the LLM explanations and the chatbot.
# Leave blank to use the built-in default (gpt-4o-mini).
OPENAI_MODEL=
