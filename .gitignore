# Virtual environment
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets - NEVER commit the real .env (only .env.example is tracked)
.env
.env.*
!.env.example

# Generated data. `python data_generator.py` writes a FRESH dataset here; it does
# NOT reproduce the preserved historical baseline in data/baseline/7126c46/.
data/raw/*.log
data/processed/*.csv
data/processed/*.json
data/*.db

# Keep the empty folder markers
!data/raw/.gitkeep
!data/processed/.gitkeep
